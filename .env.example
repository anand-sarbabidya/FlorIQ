# Free Microsoft Edge neural TTS (no API key).
# Default voice: en-US-JennyNeural — upbeat, clear female presenter.
TTS_VOICE=en-US-JennyNeural

# Optional. External TTS proxy URL for static-export hosts that cannot run /api/tts.
# Must accept POST { "text": "..." } and return audio/mpeg. Do not put secrets here.
# NEXT_PUBLIC_TTS_PROXY_URL=https://your-backend.example.com/tts

# Opt-in pure static `out/` build (disables API routes). Example:
# ENABLE_STATIC_EXPORT=1 npm run build
# or: npm run build:static
